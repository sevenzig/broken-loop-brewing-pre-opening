# Database (PostgreSQL)
# Any PostgreSQL connection string works (Neon, local, Docker, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/broken_loop_brewing

# Authentication
JWT_SECRET=change-me-to-a-random-secret

# GitHub Integration (Optional - legacy content workflow)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main
CONTENT_PATH=src/data/beers

# Upload Configuration
UPLOAD_PATH=src/data/beers

# Frontend API Configuration
VITE_API_BASE_URL=/api

# Environment
NODE_ENV=development

# Docker / Production (set automatically in docker-compose)
# SERVE_STATIC=true
# STATIC_DIR=/app/dist
# RUN_MIGRATIONS=true
