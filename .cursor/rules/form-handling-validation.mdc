## Performance Optimization

### Form Performance Patterns
```typescript
// ✅ CORRECT - Optimized form rendering
import { memo, useMemo } from 'react';

interface OptimizedFormFieldProps extends FormFieldProps {
  // Additional props for optimization
}

export const OptimizedFormField = memo<OptimizedFormFieldProps>(({
  id,
  name,
  label,
  value,
  error,
  touched,
  onChange,
  onBlur,
  ...props
}) => {
  // Memoize error state to prevent unnecessary re-renders
  const errorState = useMemo(() => ({
    hasError: !!(error && touched),
    errorMessage: error && touched ? error : null,
  }), [error, touched]);

  // Memoize describedBy calculation
  const describedBy = useMemo(() => {
    const parts = [];
    if (errorState.hasError) parts.push(`${id}-error`);
    if (props.helpText) parts.push(`${id}-help`);
    return parts.length > 0 ? parts.join(' ') : undefined;
  }, [id, errorState.hasError, props.helpText]);

  return (
    <div className="form-field">
      <label htmlFor={id} className="form-label">
        {label}
        {props.required && <span className="required-indicator">*</span>}
      </label>
      
      <input
        type={props.type || 'text'}
        id={id}
        name={name}
        value={value}
        onChange={onChange}
        onBlur={onBlur}
        className={`form-input ${errorState.hasError ? 'form-input--error' : ''}`}
        aria-describedby={describedBy}
        aria-invalid={errorState.hasError}
        {...props}
      />
      
      {errorState.errorMessage && (
        <div id={`${id}-error`} className="form-error" role="alert">
          {errorState.errorMessage}
        </div>
      )}
    </div>
  );
});

// Debounced validation for expensive operations
export const useDebouncedValidation = (
  value: any,
  validator: (value: any) => Promise<string | null>,
  delay: number = 500
) => {
  const [error, setError] = useState<string | null>(null);
  const [isValidating, setIsValidating] = useState(false);

  useEffect(() => {
    if (!value) {
      setError(null);
      return;
    }

    setIsValidating(true);
    const timeoutId = setTimeout(async () => {
      try {
        const validationError = await validator(value);
        setError(validationError);
      } catch (err) {
        setError('Validation failed');
      } finally {
        setIsValidating(false);
      }
    }, delay);

    return () => {
      clearTimeout(timeoutId);
      setIsValidating(false);
    };
  }, [value, validator, delay]);

  return { error, isValidating };
};
```

## Form Testing Patterns

### Form Testing Utilities
```typescript
// ✅ CORRECT - Form testing helpers
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';

export const fillForm = async (formData: Record<string, any>) => {
  const user = userEvent.setup();
  
  for (const [fieldName, value] of Object.entries(formData)) {
    const field = screen.getByLabelText(new RegExp(fieldName, 'i'));
    
    if (field.tagName === 'INPUT' && field.getAttribute('type') === 'checkbox') {
      if (value) {
        await user.click(field);
      }
    } else {
      await user.clear(field);
      await user.type(field, String(value));
    }
  }
};

export const submitForm = async () => {
  const user = userEvent.setup();
  const submitButton = screen.getByRole('button', { name: /submit|send/i });
  await user.click(submitButton);
};

export const expectFieldError = (fieldName: string, errorMessage: string) => {
  const field = screen.getByLabelText(new RegExp(fieldName, 'i'));
  expect(field).toHaveAttribute('aria-invalid', 'true');
  expect(screen.getByText(errorMessage)).toBeInTheDocument();
};

// Example test
describe('ContactForm', () => {
  it('validates required fields', async () => {
    const mockSubmit = jest.fn();
    render(<ContactForm onSubmit={mockSubmit} />);
    
    await submitForm();
    
    expectFieldError('name', 'Name is required');
    expectFieldError('email', 'Email is required');
    expect(mockSubmit).not.toHaveBeenCalled();
  });
  
  it('submits valid form data', async () => {
    const mockSubmit = jest.fn().mockResolvedValue(undefined);
    render(<ContactForm onSubmit={mockSubmit} />);
    
    await fillForm({
      name: 'John Doe',
      email: 'john@example.com',
      subject: 'Test Subject',
      message: 'Test message',
    });
    
    await submitForm();
    
    await waitFor(() => {
      expect(mockSubmit).toHaveBeenCalledWith({
        name: 'John Doe',
        email: 'john@example.com',
        subject: 'Test Subject',
        message: 'Test message',
      });
    });
  });
});
```

## Forbidden Patterns

### ❌ AVOID These Anti-Patterns
```typescript
// ❌ WRONG - Uncontrolled form inputs
<input type="text" defaultValue="initial" />

// ❌ WRONG - Missing validation
<form onSubmit={handleSubmit}>
  <input type="email" name="email" />
  <button type="submit">Submit</button>
</form>

// ❌ WRONG - Poor error handling
const handleSubmit = (data) => {
  fetch('/api/submit', { method: 'POST', body: JSON.stringify(data) })
    .then(() => alert('Success!'))
    .catch(() => alert('Error!')); // Generic error handling
};

// ❌ WRONG - Inaccessible form fields
<div>
  <span>Email</span>
  <input type="email" />
</div>

// ❌ WRONG - Validation on every keystroke
<input 
  onChange={(e) => {
    setValue(e.target.value);
    validateField(e.target.value); // Too aggressive
  }}
/>

// ❌ WRONG - Mutating form state directly
const handleChange = (field, value) => {
  formData[field] = value; // Direct mutation
  setFormData(formData);
};
```

## Form Development Checklist

### Before Form Creation
- [ ] Form purpose and data structure are clearly defined
- [ ] Validation requirements are documented
- [ ] Accessibility requirements are considered
- [ ] Error handling strategy is planned

### During Development
- [ ] All form fields are properly controlled
- [ ] Validation schema is comprehensive
- [ ] Error messages are user-friendly and specific
- [ ] Form is keyboard navigable
- [ ] Loading and disabled states are handled
- [ ] Form data is properly typed with TypeScript

### Before Code Review
- [ ] Form has proper ARIA attributes
- [ ] Error messages have proper roles and live regions
- [ ] Form is tested with screen readers
- [ ] Validation works on both client and server
- [ ] Form handles network errors gracefully
- [ ] Performance is optimized for large forms

### Accessibility Checklist
- [ ] All form fields have associated labels
- [ ] Required fields are properly marked
- [ ] Error messages are announced to screen readers
- [ ] Form can be completed using only keyboard
- [ ] Focus management is implemented correctly
- [ ] Color is not the only way to indicate errors

**Remember: Forms are critical user interaction points. They should be accessible, performant, and provide clear feedback to users throughout the interaction process.**
