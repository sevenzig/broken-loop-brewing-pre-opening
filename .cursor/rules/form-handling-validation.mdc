    validateRequired('Email is required'),
    validateEmail('Please enter a valid email address'),
    validateUniqueEmail(checkEmailExists),
  ],
  password: [
    validateRequired('Password is required'),
    validateMinLength(8, 'Password must be at least 8 characters'),
    validatePattern(
      /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]/,
      'Password must contain at least one uppercase letter, one lowercase letter, one number, and one special character'
    ),
  ],
  confirmPassword: [
    validateRequired('Please confirm your password'),
    validateConfirmPassword('password', 'Passwords do not match'),
  ],
  phone: [
    validatePhone('Please enter a valid phone number'),
  ],
  website: [
    validateUrl('Please enter a valid website URL'),
  ],
  age: [
    validateRequired('Age is required'),
    validateNumber('Age must be a number'),
    validateRange(13, 120, 'Age must be between 13 and 120'),
  ],
  terms: [
    (value: boolean) => value ? null : 'You must accept the terms and conditions',
  ],
};
