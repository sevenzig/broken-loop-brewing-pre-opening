## Error Handling Patterns

### Error Display Components
```typescript
// ✅ CORRECT - Reusable error display components
interface FieldErrorProps {
  error?: string;
  touched?: boolean;
  fieldId: string;
}

export const FieldError: React.FC<FieldErrorProps> = ({ error, touched, fieldId }) => {
  if (!error || !touched) return null;
  
  return (
    <div 
      id={`${fieldId}-error`} 
      className="field-error" 
      role="alert"
      aria-live="polite"
    >
      {error}
    </div>
  );
};

interface FormErrorSummaryProps {
  errors: Record<string, string>;
  touched: Record<string, boolean>;
  fieldLabels: Record<string, string>;
}

export const FormErrorSummary: React.FC<FormErrorSummaryProps> = ({ 
  errors, 
  touched, 
  fieldLabels 
}) => {
  const visibleErrors = Object.entries(errors).filter(([field, error]) => 
    error && touched[field]
  );
  
  if (visibleErrors.length === 0) return null;
  
  return (
    <div className="form-error-summary" role="alert" aria-labelledby="error-summary-title">
      <h3 id="error-summary-title">Please correct the following errors:</h3>
      <ul>
        {visibleErrors.map(([field, error]) => (
          <li key={field}>
            <a href={`#${field}`}>
              {fieldLabels[field] || field}: {error}
            </a>
          </li>
        ))}
      </ul>
    </div>
  );
};
