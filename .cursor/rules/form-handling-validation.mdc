### Server Error Integration
```typescript
// ✅ CORRECT - Server error handling
interface ServerValidationError {
  field: string;
  message: string;
}

interface ApiError {
  message: string;
  fieldErrors?: ServerValidationError[];
  code?: string;
}

export class ValidationError extends Error {
  fieldErrors: ServerValidationError[];
  
  constructor(message: string, fieldErrors: ServerValidationError[] = []) {
    super(message);
    this.name = 'ValidationError';
    this.fieldErrors = fieldErrors;
  }
}

export const handleApiError = (error: any): ValidationError => {
  if (error.response?.data?.fieldErrors) {
    return new ValidationError(
      error.response.data.message || 'Validation failed',
      error.response.data.fieldErrors
    );
  }
  
  return new ValidationError(
    error.message || 'An unexpected error occurred'
  );
};

// Usage in form submission
const handleSubmit = async (formData: ContactFormData) => {
  try {
    await submitContactForm(formData);
    showSuccessMessage('Message sent successfully!');
  } catch (error) {
    const validationError = handleApiError(error);
    
    if (validationError.fieldErrors.length > 0) {
      validationError.fieldErrors.forEach(({ field, message }) => {
        setFieldError(field, message);
      });
    } else {
      showErrorMessage(validationError.message);
    }
  }
};
