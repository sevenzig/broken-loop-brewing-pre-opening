### Testing Integration

#### Component Testing Setup
```typescript
// ComponentName.test.tsx
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { ComponentName } from './ComponentName';

describe('ComponentName', () => {
  const defaultProps = {
    // Default props for testing
  };
  
  it('renders correctly with default props', () => {
    render(<ComponentName {...defaultProps} />);
    expect(screen.getByRole('button')).toBeInTheDocument();
  });
  
  it('handles user interactions', async () => {
    const user = userEvent.setup();
    const handleClick = jest.fn();
    
    render(<ComponentName {...defaultProps} onClick={handleClick} />);
    
    await user.click(screen.getByRole('button'));
    expect(handleClick).toHaveBeenCalledTimes(1);
  });
  
  it('handles async operations', async () => {
    render(<ComponentName {...defaultProps} />);
    
    await waitFor(() => {
      expect(screen.getByText('Loaded content')).toBeInTheDocument();
    });
  });
});
```

## Examples

### Good Examples

```typescript
// Well-structured functional component
import React, { useState, useCallback, useMemo } from 'react';
import styles from './UserProfile.module.css';

interface UserProfileProps {
  user: User;
  onUpdate: (user: User) => void;
  className?: string;
}

const UserProfile: React.FC<UserProfileProps> = ({
  user,
  onUpdate,
  className = '',
}) => {
  const [isEditing, setIsEditing] = useState(false);
  const [formData, setFormData] = useState(user);

  const handleSave = useCallback(async () => {
    try {
      await onUpdate(formData);
      setIsEditing(false);
    } catch (error) {
      console.error('Failed to update user:', error);
    }
  }, [formData, onUpdate]);

  const isFormValid = useMemo(() => {
    return formData.name.trim().length > 0 && formData.email.includes('@');
  }, [formData]);

  return (
    <div className={`${styles.container} ${className}`}>
      <h2 className={styles.title}>{user.name}</h2>
      {isEditing ? (
        <form onSubmit={(e) => { e.preventDefault(); handleSave(); }}>
          <input
            type="text"
            value={formData.name}
            onChange={(e) => setFormData(prev => ({ ...prev, name: e.target.value }))}
            className={styles.input}
            aria-label="User name"
          />
          <button type="submit" disabled={!isFormValid} className={styles.button}>
            Save
          </button>
        </form>
      ) : (
        <button onClick={() => setIsEditing(true)} className={styles.button}>
          Edit
        </button>
      )}
    </div>
  );
};

export default UserProfile;
```

```typescript
// Proper error boundary implementation
class ComponentErrorBoundary extends React.Component<
  React.PropsWithChildren<{}>,
  { hasError: boolean; error?: Error }
> {
  constructor(props: React.PropsWithChildren<{}>) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error) {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    console.error('Component Error Boundary caught an error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return (
        <div className="error-boundary">
          <h2>Something went wrong</h2>
          <p>We're sorry, but something unexpected happened.</p>
          <button onClick={() => window.location.reload()}>
            Reload Page
          </button>
        </div>
      );
    }

    return this.props.children;
  }
}
```

### Bad Examples

```typescript
// Untyped component with poor structure
const UserProfile = ({ user, onUpdate }) => {
  const [editing, setEditing] = useState();
  const [data, setData] = useState();
  
  const handleClick = (e) => {
    setEditing(true);
  };
  
  return (
    <div>
      <h2>{user.name}</h2>
      <button onClick={handleClick}>Edit</button>
    </div>
  );
};
```
*Fails: No TypeScript types, poor state management, generic handler names, no accessibility attributes.*

```typescript
// Component with performance issues
const ExpensiveComponent = ({ items }) => {
  const expensiveList = items.filter(item => item.active)
    .sort((a, b) => a.name.localeCompare(b.name))
    .map(item => <div key={item.id}>{item.name}</div>);
  
  return (
    <div>
      {expensiveList}
    </div>
  );
};
```
*Fails: Expensive computation in render, no memoization, potential re-render issues.*

```typescript
// Component with accessibility issues
const Button = ({ children, onClick }) => {
  return (
    <div onClick={onClick} style={{ cursor: 'pointer' }}>
      {children}
    </div>
  );
};
```
*Fails: Uses div instead of button element, no keyboard support, no ARIA attributes, inline styles.*

## Implementation Guidelines

### Component Development Workflow

1. **Plan Component Structure**
   - Define single responsibility
   - Design props interface
   - Plan state management strategy

2. **Implement Core Functionality**
   - Create TypeScript interfaces
   - Implement component logic
   - Add proper event handlers

3. **Add Styling and Accessibility**
   - Use CSS Modules for styling
   - Add ARIA attributes
   - Implement keyboard navigation

4. **Optimize Performance**
   - Add memoization where needed
   - Implement proper dependency arrays
   - Consider component splitting

5. **Add Error Handling**
   - Implement error boundaries
   - Add proper error states
   - Handle edge cases

6. **Write Tests**
   - Unit tests for component logic
   - Integration tests for user interactions
   - Accessibility tests

### Code Review Checklist

#### Before Component Creation
- [ ] Component has a single, clear responsibility
- [ ] Props interface is properly typed
- [ ] Component name follows PascalCase convention
- [ ] File structure follows established patterns

#### During Development
- [ ] All props are destructured with default values
- [ ] Event handlers are properly typed
- [ ] State updates use functional form when dependent on previous state
- [ ] Effects have proper dependency arrays
- [ ] Expensive computations are memoized
- [ ] Component handles loading and error states

#### Before Code Review
- [ ] Component is properly exported with barrel export
- [ ] CSS classes use CSS Modules
- [ ] Accessibility attributes are included
- [ ] Component has unit tests
- [ ] No console.log statements remain
- [ ] TypeScript strict mode passes
- [ ] ESLint rules pass

#### Performance Checklist
- [ ] Unnecessary re-renders are prevented
- [ ] Large lists use virtualization if needed
- [ ] Images have proper loading attributes
- [ ] Components are split appropriately
- [ ] Bundle size impact is considered

### Forbidden Patterns

#### ❌ AVOID These Patterns
```typescript
// ❌ WRONG - Inline object/array creation in render
<Component style={{ margin: 10 }} items={[1, 2, 3]} />

// ❌ WRONG - Anonymous functions in JSX
<button onClick={() => handleClick(item.id)}>Click</button>

// ❌ WRONG - Mutating props
props.items.push(newItem);

// ❌ WRONG - Using array index as key
{items.map((item, index) => <Item key={index} item={item} />)}

// ❌ WRONG - Conditional hooks
if (condition) {
  useEffect(() => { ... }, []);
}

// ❌ WRONG - Missing dependencies in useEffect
useEffect(() => {
  fetchData(userId);
}, []); // Missing userId dependency

// ❌ WRONG - Direct DOM manipulation
document.getElementById('myElement').style.display = 'none';
```

