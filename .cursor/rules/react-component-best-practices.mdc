# React Component Best Practices

## Purpose and Scope

This rule enforces comprehensive React component architecture standards, TypeScript integration patterns, and best practices for building maintainable, performant, and accessible React applications. It establishes mandatory patterns for component structure, state management, performance optimization, and testing integration.

## Standards and Requirements

### Component Architecture Standards

#### File Structure Requirements
```
src/
├── components/
│   ├── ComponentName/
│   │   ├── ComponentName.tsx          # Main component
│   │   ├── ComponentName.module.css   # Scoped styles
│   │   ├── ComponentName.test.tsx     # Unit tests
│   │   └── index.ts                   # Export barrel
│   └── shared/                        # Reusable components
│       ├── Button/
│       ├── Input/
│       └── Modal/
```

#### Component Naming Conventions
```typescript
// ✅ CORRECT - PascalCase for components
const UserProfile: React.FC = () => { ... };
const NavigationMenu: React.FC = () => { ... };

// ❌ WRONG - camelCase or other formats
const userProfile = () => { ... };
const navigation_menu = () => { ... };
```

#### Export Patterns
```typescript
// ComponentName/index.ts - ALWAYS use barrel exports
export { ComponentName } from './ComponentName';
export type { ComponentNameProps } from './ComponentName';

// Usage in other files
import { ComponentName } from '@components/ComponentName';
```

### TypeScript Integration - MANDATORY

#### Component Props Interface
```typescript
// ✅ CORRECT - Explicit interface definition
interface ButtonProps {
  children: React.ReactNode;
  variant?: 'primary' | 'secondary' | 'danger';
  size?: 'small' | 'medium' | 'large';
  disabled?: boolean;
  onClick?: (event: React.MouseEvent<HTMLButtonElement>) => void;
  className?: string;
  'aria-label'?: string;
}

const Button: React.FC<ButtonProps> = ({
  children,
  variant = 'primary',
  size = 'medium',
  disabled = false,
  onClick,
  className,
  'aria-label': ariaLabel,
}) => {
  // Component implementation
};

// ❌ WRONG - No type definitions
const Button = ({ children, variant, onClick }) => { ... };
```

#### Event Handler Typing
```typescript
// ✅ CORRECT - Properly typed event handlers
const handleClick = (event: React.MouseEvent<HTMLButtonElement>) => {
  event.preventDefault();
  // Handle click
};

const handleChange = (event: React.ChangeEvent<HTMLInputElement>) => {
  const value = event.target.value;
  // Handle change
};

const handleSubmit = (event: React.FormEvent<HTMLFormElement>) => {
  event.preventDefault();
  // Handle form submission
};

// ❌ WRONG - Untyped events
const handleClick = (event) => { ... };
```

#### Ref Typing
```typescript
// ✅ CORRECT - Properly typed refs
const inputRef = useRef<HTMLInputElement>(null);
const divRef = useRef<HTMLDivElement>(null);

// Forward refs with proper typing
const Input = React.forwardRef<HTMLInputElement, InputProps>(
  ({ className, ...props }, ref) => {
    return <input ref={ref} className={className} {...props} />;
  }
);
```

### Component Structure Standards

#### Functional Component Template
```typescript
import React, { useState, useEffect, useCallback } from 'react';
import styles from './ComponentName.module.css';

interface ComponentNameProps {
  // Props interface here
}

const ComponentName: React.FC<ComponentNameProps> = ({
  // Destructured props with defaults
}) => {
  // 1. State declarations
  const [state, setState] = useState<StateType>(initialValue);
  
  // 2. Refs
  const elementRef = useRef<HTMLElement>(null);
  
  // 3. Custom hooks
  const customHookResult = useCustomHook();
  
  // 4. Effect hooks
  useEffect(() => {
    // Effect logic
    return () => {
      // Cleanup
    };
  }, [dependencies]);
  
  // 5. Event handlers
  const handleEvent = useCallback((event: EventType) => {
    // Handler logic
  }, [dependencies]);
  
  // 6. Computed values
  const computedValue = useMemo(() => {
    return expensiveComputation(state);
  }, [state]);
  
  // 7. Early returns for loading/error states
  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage error={error} />;
  
  // 8. Main render
  return (
    <div className={styles.container}>
      {/* Component JSX */}
    </div>
  );
};

export default ComponentName;
export type { ComponentNameProps };
```

### State Management Best Practices

#### useState Patterns
```typescript
// ✅ CORRECT - Typed state with proper initial values
const [user, setUser] = useState<User | null>(null);
const [loading, setLoading] = useState<boolean>(false);
const [errors, setErrors] = useState<string[]>([]);

// Complex state with reducer pattern
interface FormState {
  values: Record<string, string>;
  errors: Record<string, string>;
  touched: Record<string, boolean>;
}

const [formState, setFormState] = useReducer(formReducer, initialFormState);

// ❌ WRONG - Untyped or poorly structured state
const [data, setData] = useState();
const [stuff, setStuff] = useState({});
```

#### State Updates
```typescript
// ✅ CORRECT - Functional updates for dependent state
setCount(prevCount => prevCount + 1);
setItems(prevItems => [...prevItems, newItem]);
setUser(prevUser => ({ ...prevUser, name: newName }));

// ❌ WRONG - Direct state mutation
items.push(newItem); // Mutating state directly
setUser(user.name = newName); // Incorrect syntax
```

### Performance Optimization

#### Memoization Patterns
```typescript
// ✅ CORRECT - Memoize expensive computations
const expensiveValue = useMemo(() => {
  return items.filter(item => item.active).sort((a, b) => a.name.localeCompare(b.name));
}, [items]);

// ✅ CORRECT - Memoize callback functions
const handleItemClick = useCallback((itemId: string) => {
  onItemSelect(itemId);
}, [onItemSelect]);

// ✅ CORRECT - Memoize components with React.memo
const ListItem = React.memo<ListItemProps>(({ item, onSelect }) => {
  return (
    <div onClick={() => onSelect(item.id)}>
      {item.name}
    </div>
  );
});

// ❌ WRONG - Unnecessary memoization
const simpleValue = useMemo(() => props.name, [props.name]); // Too simple
const handleClick = useCallback(() => console.log('clicked'), []); // No dependencies needed
```

#### Component Splitting
```typescript
// ✅ CORRECT - Split large components
const UserProfile: React.FC<UserProfileProps> = ({ user }) => {
  return (
    <div className={styles.profile}>
      <UserAvatar user={user} />
      <UserDetails user={user} />
      <UserActions user={user} />
