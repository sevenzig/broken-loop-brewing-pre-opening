### Caching Strategies

#### Memory Caching
```typescript
// ✅ CORRECT - Hook with caching
const dataCache = new Map<string, { data: any; timestamp: number; ttl: number }>();

export function useCachedData<T>(
  key: string,
  fetcher: () => Promise<T>,
  ttl: number = 5 * 60 * 1000 // 5 minutes default
) {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadData = async (forceRefresh = false) => {
    // Check cache first
    if (!forceRefresh) {
      const cached = dataCache.get(key);
      if (cached && Date.now() - cached.timestamp < cached.ttl) {
        setData(cached.data);
        setLoading(false);
        return;
      }
    }

    try {
      setLoading(true);
      setError(null);
      const result = await fetcher();
      
      // Cache the result
      dataCache.set(key, {
        data: result,
        timestamp: Date.now(),
        ttl,
      });
      
      setData(result);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to load data');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, [key]);

  return {
    data,
    loading,
    error,
    refresh: () => loadData(true),
    clearCache: () => dataCache.delete(key),
  };
}
```

### Hook Composition Patterns

#### Combining Hooks
```typescript
// ✅ CORRECT - Composable hooks
export function useEntityManagement<T extends { id: string }>(
  entityName: string,
  loader: () => Promise<T[]>,
  validator: (item: T) => boolean
) {
  // Compose multiple hooks
  const {
    data: allItems,
    loading: loadingAll,
    error: loadError,
    reload,
  } = useAsyncData(loader, undefined, { immediate: true });

  const {
    results: searchResults,
    loading: searching,
    error: searchError,
  } = useDebouncedSearch('', async (term) => {
    return allItems?.filter(item => 
      JSON.stringify(item).toLowerCase().includes(term.toLowerCase())
    ) || [];
  });

  const validItems = useMemo(() => {
    return allItems?.filter(validator) || [];
  }, [allItems, validator]);

  return {
    // Data
    allItems: allItems || [],
    validItems,
    searchResults,
    
    // State
    loading: loadingAll,
    searching,
    error: loadError || searchError,
    
    // Actions
    reload,
    
    // Stats
    stats: {
      total: allItems?.length || 0,
      valid: validItems.length,
      invalid: (allItems?.length || 0) - validItems.length,
    },
  };
}
```

### Testing Patterns

#### Hook Testing Setup
```typescript
// ✅ CORRECT - Testable hook structure
export function useTestableHook<T>(
  fetcher: () => Promise<T>,
  options: { onSuccess?: (data: T) => void } = {}
) {
  const [state, setState] = useState({
    data: null as T | null,
    loading: true,
    error: null as string | null,
  });

  const loadData = useCallback(async () => {
    setState(prev => ({ ...prev, loading: true, error: null }));
    
    try {
      const data = await fetcher();
      setState({ data, loading: false, error: null });
      options.onSuccess?.(data);
    } catch (err) {
      setState(prev => ({
        ...prev,
        loading: false,
        error: err instanceof Error ? err.message : 'Unknown error',
      }));
    }
  }, [fetcher, options]);

  useEffect(() => {
    loadData();
  }, [loadData]);

  return {
    ...state,
    reload: loadData,
  };
}

// Test helper
export const createMockFetcher = <T>(data: T, delay = 0, shouldFail = false) => {
  return jest.fn(() => 
    new Promise<T>((resolve, reject) => {
      setTimeout(() => {
        if (shouldFail) {
          reject(new Error('Mock error'));
        } else {
          resolve(data);
        }
      }, delay);
    })
  );
};
```

## Examples

### Good Examples

```typescript
// ✅ CORRECT - Well-structured collection hook
export function useBeers() {
  const [beers, setBeers] = useState<Beer[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadBeers = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      const data = await beerLoader.loadAll();
      setBeers(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to load beers');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadBeers();
  }, [loadBeers]);

  return {
    beers,
    loading,
    error,
    reload: loadBeers,
  };
}
```

```typescript
// ✅ CORRECT - Properly typed utility hook
export function useLocalStorage<T>(key: string, defaultValue: T) {
  const [value, setValue] = useState<T>(() => {
    try {
      const item = window.localStorage.getItem(key);
      return item ? JSON.parse(item) : defaultValue;
    } catch {
      return defaultValue;
    }
  });

  const setStoredValue = useCallback((newValue: T) => {
    try {
      setValue(newValue);
      window.localStorage.setItem(key, JSON.stringify(newValue));
    } catch (error) {
      console.error('Error saving to localStorage:', error);
    }
  }, [key]);

  return [value, setStoredValue] as const;
}
```

