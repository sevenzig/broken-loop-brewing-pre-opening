### Hook Structure Standards

#### Collection Hook Template
```typescript
import { useState, useEffect, useMemo } from 'react';
import type { LoaderFunction, FilterFunction, StatsFunction } from './types';

interface UseCollectionReturn<T> {
  // Data
  allItems: T[];
  featuredItems: T[];
  filteredItems: T[];
  stats: CollectionStats;
  
  // State
  loading: boolean;
  error: string | null;
  
  // Actions
  reload: () => Promise<void>;
  clearError: () => void;
}

export function useCollection<T>(
  loader: LoaderFunction<T>,
  filters: Record<string, FilterFunction<T>>,
  statsCalculator: StatsFunction<T>
): UseCollectionReturn<T> {
  const [allItems, setAllItems] = useState<T[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadData = async () => {
    try {
      setLoading(true);
      setError(null);
      const items = await loader();
      setAllItems(items);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to load data');
      console.error('Error loading collection:', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  // Memoized computed values
  const featuredItems = useMemo(() => 
    filters.featured ? filters.featured(allItems) : [], 
    [allItems, filters.featured]
  );

  const stats = useMemo(() => 
    statsCalculator(allItems), 
    [allItems, statsCalculator]
  );

  const clearError = () => setError(null);

  return {
    // Data
    allItems,
    featuredItems,
    filteredItems: allItems, // Override in specific implementations
    stats,
    
    // State
    loading,
    error,
    
    // Actions
    reload: loadData,
    clearError,
  };
}
```

#### Single Item Hook Template
```typescript
import { useState, useEffect } from 'react';

interface UseSingleItemReturn<T> {
  item: T | null;
  loading: boolean;
  error: string | null;
  reload: () => Promise<void>;
}

export function useSingleItem<T>(
  id: string | undefined,
  loader: (id: string) => Promise<T | null>,
  entityName: string
): UseSingleItemReturn<T> {
  const [item, setItem] = useState<T | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const loadItem = async () => {
    if (!id) {
      setError(`${entityName} ID is required`);
      setLoading(false);
      return;
    }

    try {
      setLoading(true);
      setError(null);
      const foundItem = await loader(id);
      
      if (!foundItem) {
        setError(`${entityName} with ID "${id}" not found`);
      } else {
        setItem(foundItem);
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : `Failed to load ${entityName.toLowerCase()}`);
      console.error(`Error loading ${entityName.toLowerCase()} ${id}:`, err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadItem();
  }, [id]);

  return {
    item,
    loading,
    error,
    reload: loadItem,
  };
}
```

### Error Handling Standards

#### Error State Management
```typescript
// ✅ CORRECT - Comprehensive error handling
export function useDataWithErrorHandling<T>() {
  const [data, setData] = useState<T[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [retryCount, setRetryCount] = useState(0);

  const loadData = async (isRetry = false) => {
    try {
      setLoading(true);
      if (!isRetry) {
        setError(null);
      }
      
      const result = await fetchData();
      setData(result);
      setRetryCount(0); // Reset retry count on success
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'Unknown error occurred';
      setError(errorMessage);
      
      // Log error with context
      console.error('Data loading failed:', {
        error: err,
        retryCount,
        timestamp: new Date().toISOString(),
      });
    } finally {
      setLoading(false);
    }
  };

  const retry = () => {
    if (retryCount < 3) {
      setRetryCount(prev => prev + 1);
      loadData(true);
    }
  };

  const clearError = () => {
    setError(null);
    setRetryCount(0);
  };

  return {
    data,
    loading,
    error,
    retryCount,
    canRetry: retryCount < 3,
    retry,
    clearError,
    reload: () => loadData(false),
  };
}

// ❌ WRONG - Poor error handling
export function useBadErrorHandling() {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchData().then(setData).catch(console.log); // Silent failure
    setLoading(false);
  }, []);

  return { data, loading }; // No error state
}
```

#### Error Recovery Patterns
```typescript
// ✅ CORRECT - Graceful degradation
export function useDataWithFallback<T>(
  primaryLoader: () => Promise<T[]>,
  fallbackLoader?: () => Promise<T[]>,
  fallbackData?: T[]
) {
  const [data, setData] = useState<T[]>(fallbackData || []);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [usingFallback, setUsingFallback] = useState(false);

  const loadData = async () => {
    try {
      setLoading(true);
      setError(null);
      setUsingFallback(false);
      
      const result = await primaryLoader();
      setData(result);
    } catch (primaryError) {
      console.warn('Primary data source failed, trying fallback:', primaryError);
      
      if (fallbackLoader) {
        try {
          const fallbackResult = await fallbackLoader();
          setData(fallbackResult);
          setUsingFallback(true);
        } catch (fallbackError) {
          setError('Both primary and fallback data sources failed');
          if (fallbackData) {
            setData(fallbackData);
            setUsingFallback(true);
          }
        }
      } else if (fallbackData) {
        setData(fallbackData);
        setUsingFallback(true);
      } else {
        setError(primaryError instanceof Error ? primaryError.message : 'Data loading failed');
      }
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  return {
    data,
    loading,
    error,
    usingFallback,
    reload: loadData,
  };
}
```

### Performance Optimization

#### Memoization Patterns
```typescript
// ✅ CORRECT - Proper memoization in hooks
export function useOptimizedData<T>(
  rawData: T[],
  filters: FilterConfig,
  sortConfig: SortConfig
) {
  // Memoize expensive filtering
  const filteredData = useMemo(() => {
    if (!rawData.length) return [];
    
    return rawData.filter(item => {
      return Object.entries(filters).every(([key, value]) => {
        if (!value) return true;
        return item[key as keyof T] === value;
      });
    });
  }, [rawData, filters]);

  // Memoize expensive sorting
  const sortedData = useMemo(() => {
    if (!filteredData.length) return [];
    
    return [...filteredData].sort((a, b) => {
      const aValue = a[sortConfig.field as keyof T];
      const bValue = b[sortConfig.field as keyof T];
      
      if (typeof aValue === 'string' && typeof bValue === 'string') {
        return sortConfig.direction === 'asc' 
          ? aValue.localeCompare(bValue)
          : bValue.localeCompare(aValue);
      }
      
      return sortConfig.direction === 'asc' 
        ? (aValue as any) - (bValue as any)
        : (bValue as any) - (aValue as any);
    });
  }, [filteredData, sortConfig]);

  // Memoize statistics calculation
  const stats = useMemo(() => {
    return {
      total: rawData.length,
      filtered: filteredData.length,
      categories: rawData.reduce((acc, item) => {
        const category = item.category as string;
        acc[category] = (acc[category] || 0) + 1;
        return acc;
      }, {} as Record<string, number>),
    };
  }, [rawData, filteredData]);

  return {
    data: sortedData,
    stats,
  };
}

// ❌ WRONG - Unnecessary memoization
export function useOverMemoized(simpleValue: string) {
  const memoizedValue = useMemo(() => simpleValue, [simpleValue]); // Unnecessary
  return memoizedValue;
}
```

#### Debouncing and Throttling
```typescript
// ✅ CORRECT - Debounced search hook
export function useDebouncedSearch<T>(
  searchTerm: string,
  searchFunction: (term: string) => Promise<T[]>,
  delay: number = 300
) {
  const [results, setResults] = useState<T[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Debounce the search term
  const debouncedSearchTerm = useMemo(() => {
    const handler = setTimeout(() => searchTerm, delay);
    return () => clearTimeout(handler);
  }, [searchTerm, delay]);

  useEffect(() => {
    if (!searchTerm.trim()) {
      setResults([]);
      return;
    }

    const performSearch = async () => {
      try {
        setLoading(true);
        setError(null);
        const searchResults = await searchFunction(searchTerm);
        setResults(searchResults);
      } catch (err) {
        setError(err instanceof Error ? err.message : 'Search failed');
        setResults([]);
      } finally {
        setLoading(false);
      }
    };

    const timeoutId = setTimeout(performSearch, delay);
    return () => clearTimeout(timeoutId);
  }, [searchTerm, searchFunction, delay]);

  return {
    results,
    loading,
    error,
    hasSearched: searchTerm.trim().length > 0,
  };
}
```

### TypeScript Integration

#### Generic Hook Patterns
```typescript
// ✅ CORRECT - Properly typed generic hooks
export function useAsyncData<T, P = void>(
  asyncFunction: (params: P) => Promise<T>,
  params: P,
  options: {
    immediate?: boolean;
    onSuccess?: (data: T) => void;
    onError?: (error: Error) => void;
  } = {}
) {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState(options.immediate ?? true);
  const [error, setError] = useState<Error | null>(null);

  const execute = useCallback(async (executeParams?: P) => {
    try {
      setLoading(true);
      setError(null);
      const result = await asyncFunction(executeParams ?? params);
      setData(result);
      options.onSuccess?.(result);
      return result;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('Unknown error');
      setError(error);
      options.onError?.(error);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [asyncFunction, params, options]);

  useEffect(() => {
    if (options.immediate) {
      execute();
    }
  }, [execute, options.immediate]);

  return {
    data,
    loading,
    error,
    execute,
    reset: () => {
      setData(null);
      setError(null);
      setLoading(false);
    },
  };
}

// Hook return type inference
export type UseAsyncDataReturn<T> = ReturnType<typeof useAsyncData<T>>;
```

