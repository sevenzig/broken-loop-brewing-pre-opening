## Request/Response Type Safety

### TypeScript API Contracts
```typescript
// ✅ CORRECT - Comprehensive API type definitions
// Base types
interface BaseEntity {
  id: string;
  createdAt: string;
  updatedAt: string;
}

interface ApiResponse<T> {
  success: boolean;
  data: T;
  message?: string;
  errors?: ValidationError[];
}

interface ValidationError {
  field: string;
  message: string;
  code: string;
}

// Request/Response pairs
interface ContactFormRequest {
  name: string;
  email: string;
  phone?: string;
  subject: string;
  message: string;
}

interface ContactFormResponse {
  id: string;
  status: 'pending' | 'processed' | 'replied';
  submittedAt: string;
}

// Generic API response wrapper
type ApiResult<T> = Promise<ApiResponse<T>>;

// Service with type-safe methods
class ContactService {
  async submitForm(data: ContactFormRequest): ApiResult<ContactFormResponse> {
    return apiClient.post<ApiResponse<ContactFormResponse>>('/contact', data);
  }

  async getSubmissions(
    params: PaginationParams = {}
  ): ApiResult<PaginatedResponse<ContactFormResponse & ContactFormRequest>> {
    const queryParams = new URLSearchParams();
    Object.entries(params).forEach(([key, value]) => {
      if (value !== undefined) {
        queryParams.append(key, String(value));
      }
    });

    return apiClient.get<ApiResponse<PaginatedResponse<ContactFormResponse & ContactFormRequest>>>(
      `/contact/submissions?${queryParams.toString()}`
    );
  }

  async getSubmissionById(id: string): ApiResult<ContactFormResponse & ContactFormRequest> {
    return apiClient.get<ApiResponse<ContactFormResponse & ContactFormRequest>>(
      `/contact/submissions/${id}`
    );
  }

  async updateSubmissionStatus(
    id: string, 
    status: ContactFormResponse['status']
  ): ApiResult<ContactFormResponse> {
    return apiClient.patch<ApiResponse<ContactFormResponse>>(
      `/contact/submissions/${id}`,
      { status }
    );
  }
}

export const contactService = new ContactService();
