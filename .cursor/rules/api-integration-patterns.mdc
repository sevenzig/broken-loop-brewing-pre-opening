## API Testing Patterns

### Mock Service and Testing Utilities
```typescript
// ✅ CORRECT - API testing utilities
import { jest } from '@jest/globals';
import { AxiosResponse } from 'axios';

// Mock API responses
export const createMockApiResponse = <T>(
  data: T,
  status: number = 200,
  statusText: string = 'OK'
): AxiosResponse<T> => ({
  data,
  status,
  statusText,
  headers: {},
  config: {} as any,
});

export const createMockApiError = (
  status: number,
  message: string,
  data?: any
) => {
  const error = new Error(message) as any;
  error.response = {
    status,
    data: data || { message },
    headers: {},
  };
  return error;
};

// Mock service factory
export class MockApiService<T> {
  private mockData: T[] = [];
  private delay: number = 0;

  constructor(initialData: T[] = [], delay: number = 0) {
    this.mockData = [...initialData];
    this.delay = delay;
  }

  setData(data: T[]): void {
    this.mockData = [...data];
  }

  setDelay(delay: number): void {
    this.delay = delay;
  }

  private async simulateDelay(): Promise<void> {
    if (this.delay > 0) {
      await new Promise(resolve => setTimeout(resolve, this.delay));
    }
  }

  async getAll(): Promise<T[]> {
    await this.simulateDelay();
    return [...this.mockData];
  }

  async getById(id: string): Promise<T | null> {
    await this.simulateDelay();
    return this.mockData.find((item: any) => item.id === id) || null;
  }

  async create(data: Partial<T>): Promise<T> {
    await this.simulateDelay();
    const newItem = {
      ...data,
      id: `mock_${Date.now()}`,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
    } as T;
    
    this.mockData.push(newItem);
    return newItem;
  }

  async update(id: string, data: Partial<T>): Promise<T> {
    await this.simulateDelay();
    const index = this.mockData.findIndex((item: any) => item.id === id);
    
    if (index === -1) {
      throw createMockApiError(404, 'Item not found');
    }

    const updatedItem = {
      ...this.mockData[index],
      ...data,
      updatedAt: new Date().toISOString(),
    };
    
    this.mockData[index] = updatedItem;
    return updatedItem;
  }

  async delete(id: string): Promise<void> {
    await this.simulateDelay();
    const index = this.mockData.findIndex((item: any) => item.id === id);
    
    if (index === -1) {
      throw createMockApiError(404, 'Item not found');
    }

    this.mockData.splice(index, 1);
  }

  simulateError(status: number, message: string): void {
    throw createMockApiError(status, message);
  }
}

// Test utilities
export const setupApiMocks = () => {
  const mockGet = jest.fn();
  const mockPost = jest.fn();
  const mockPut = jest.fn();
  const mockPatch = jest.fn();
  const mockDelete = jest.fn();

  // Mock axios
  jest.mock('axios', () => ({
    create: jest.fn(() => ({
      get: mockGet,
      post: mockPost,
      put: mockPut,
      patch: mockPatch,
      delete: mockDelete,
      interceptors: {
        request: { use: jest.fn() },
        response: { use: jest.fn() },
      },
    })),
  }));

  return {
    mockGet,
    mockPost,
    mockPut,
    mockPatch,
    mockDelete,
  };
};

// Example test
describe('BeerService', () => {
  let mockBeerService: MockApiService<Beer>;

  beforeEach(() => {
    const mockBeers: Beer[] = [
      {
        id: '1',
        name: 'Test IPA',
        style: 'IPA',
        abv: 6.5,
        ibu: 65,
        description: 'A hoppy test beer',
        available: true,
        featured: false,
        createdAt: '2023-01-01T00:00:00Z',
        updatedAt: '2023-01-01T00:00:00Z',
      },
    ];

    mockBeerService = new MockApiService(mockBeers);
  });

  it('should fetch all beers', async () => {
    const beers = await mockBeerService.getAll();
    expect(beers).toHaveLength(1);
    expect(beers[0].name).toBe('Test IPA');
  });

  it('should create a new beer', async () => {
    const newBeer = await mockBeerService.create({
      name: 'New Beer',
      style: 'Lager',
      abv: 4.5,
      ibu: 20,
      description: 'A crisp lager',
      available: true,
      featured: false,
    });

    expect(newBeer.name).toBe('New Beer');
    expect(newBeer.id).toBeDefined();
    expect(newBeer.createdAt).toBeDefined();
  });

  it('should handle errors gracefully', async () => {
    await expect(mockBeerService.getById('nonexistent')).resolves.toBeNull();
    
    await expect(
      mockBeerService.update('nonexistent', { name: 'Updated' })
    ).rejects.toThrow('Item not found');
  });

  it('should simulate network delays', async () => {
    mockBeerService.setDelay(100);
    
    const startTime = Date.now();
    await mockBeerService.getAll();
    const endTime = Date.now();
    
    expect(endTime - startTime).toBeGreaterThanOrEqual(100);
  });
});
