## Service Layer Architecture

### Resource-Based Service Pattern
```typescript
// ✅ CORRECT - Resource-based API service
interface PaginationParams {
  page?: number;
  limit?: number;
  sort?: string;
  order?: 'asc' | 'desc';
}

interface FilterParams {
  [key: string]: any;
}

interface PaginatedResponse<T> {
  data: T[];
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
    hasNext: boolean;
    hasPrev: boolean;
  };
}

abstract class BaseService<T, CreateT = Partial<T>, UpdateT = Partial<T>> {
  protected abstract resourcePath: string;

  async getAll(
    params: PaginationParams & FilterParams = {}
  ): Promise<PaginatedResponse<T>> {
    const queryParams = new URLSearchParams();
    
    Object.entries(params).forEach(([key, value]) => {
      if (value !== undefined && value !== null && value !== '') {
        queryParams.append(key, String(value));
      }
    });

    const url = `${this.resourcePath}?${queryParams.toString()}`;
    return apiClient.get<PaginatedResponse<T>>(url);
  }

  async getById(id: string): Promise<T> {
    return apiClient.get<T>(`${this.resourcePath}/${id}`);
  }

  async create(data: CreateT): Promise<T> {
    return apiClient.post<T>(this.resourcePath, data);
  }

  async update(id: string, data: UpdateT): Promise<T> {
    return apiClient.put<T>(`${this.resourcePath}/${id}`, data);
  }

  async partialUpdate(id: string, data: Partial<UpdateT>): Promise<T> {
    return apiClient.patch<T>(`${this.resourcePath}/${id}`, data);
  }

  async delete(id: string): Promise<void> {
    return apiClient.delete<void>(`${this.resourcePath}/${id}`);
  }

  async bulkDelete(ids: string[]): Promise<void> {
    return apiClient.post<void>(`${this.resourcePath}/bulk-delete`, { ids });
  }

  async search(query: string, filters: FilterParams = {}): Promise<T[]> {
    const params = { q: query, ...filters };
    const queryParams = new URLSearchParams();
    
    Object.entries(params).forEach(([key, value]) => {
      if (value !== undefined && value !== null && value !== '') {
        queryParams.append(key, String(value));
      }
    });

    return apiClient.get<T[]>(`${this.resourcePath}/search?${queryParams.toString()}`);
  }
}

// Example service implementation
interface Beer {
  id: string;
  name: string;
  style: string;
  abv: number;
  ibu: number;
  description: string;
  available: boolean;
  featured: boolean;
  createdAt: string;
  updatedAt: string;
}

interface CreateBeerRequest {
  name: string;
  style: string;
  abv: number;
  ibu: number;
  description: string;
  available?: boolean;
  featured?: boolean;
}

interface UpdateBeerRequest extends Partial<CreateBeerRequest> {}

class BeerService extends BaseService<Beer, CreateBeerRequest, UpdateBeerRequest> {
  protected resourcePath = '/beers';

  async getFeatured(): Promise<Beer[]> {
    return apiClient.get<Beer[]>(`${this.resourcePath}/featured`);
  }

  async getByStyle(style: string): Promise<Beer[]> {
    return apiClient.get<Beer[]>(`${this.resourcePath}/by-style/${encodeURIComponent(style)}`);
  }

  async toggleFeatured(id: string): Promise<Beer> {
    return apiClient.post<Beer>(`${this.resourcePath}/${id}/toggle-featured`);
  }

  async toggleAvailability(id: string): Promise<Beer> {
    return apiClient.post<Beer>(`${this.resourcePath}/${id}/toggle-availability`);
  }

  async getStats(): Promise<{
    total: number;
    available: number;
    featured: number;
    byStyle: Record<string, number>;
  }> {
    return apiClient.get(`${this.resourcePath}/stats`);
  }
}

export const beerService = new BeerService();
