### Security Best Practices

#### 14. Rate Limiting Implementation
```typescript
// ✅ CORRECT - Basic rate limiting
const rateLimitMap = new Map();

export default function middleware(request: Request) {
  const ip = ipAddress(request) || 'unknown';
  const now = Date.now();
  const windowMs = 15 * 60 * 1000; // 15 minutes
  const maxRequests = 100;
  
  const requests = rateLimitMap.get(ip) || [];
  const validRequests = requests.filter((time: number) => now - time < windowMs);
  
  if (validRequests.length >= maxRequests) {
    return new Response('Too Many Requests', { status: 429 });
  }
  
  validRequests.push(now);
  rateLimitMap.set(ip, validRequests);
  
  return new Response('OK');
}
```

#### 15. Authentication Middleware
```typescript
// ✅ CORRECT - JWT authentication
import { jwtVerify } from 'jose';

export default async function middleware(request: Request) {
  const token = request.headers.get('authorization')?.replace('Bearer ', '');
  
  if (!token) {
    return new Response('Unauthorized', { status: 401 });
  }
  
  try {
    const secret = new TextEncoder().encode(process.env.JWT_SECRET);
    await jwtVerify(token, secret);
    return new Response('OK');
  } catch (error) {
    return new Response('Invalid token', { status: 401 });
  }
}
```

### Error Handling

#### 16. Comprehensive Error Handling
```typescript
// ✅ CORRECT - Proper error handling
export default function middleware(request: Request) {
  try {
    // Middleware logic
    const result = processRequest(request);
    return new Response(JSON.stringify(result));
  } catch (error) {
    console.error('Middleware error:', error);
    
    return new Response(
      JSON.stringify({ 
        error: 'Internal server error',
        message: process.env.NODE_ENV === 'development' ? error.message : 'Something went wrong'
      }),
      { 
        status: 500,
        headers: { 'Content-Type': 'application/json' }
      }
    );
  }
}
```

### Monitoring and Logging

#### 17. Request Logging
```typescript
// ✅ CORRECT - Comprehensive logging
export default function middleware(request: Request, context: RequestContext) {
  const startTime = Date.now();
  const ip = ipAddress(request);
  const userAgent = request.headers.get('user-agent');
  
  // Log request details
  console.log({
    method: request.method,
    url: request.url,
    ip,
    userAgent,
    timestamp: new Date().toISOString()
  });
  
  const response = new Response('OK');
  
  // Log response time
  context.waitUntil(
    Promise.resolve().then(() => {
      const duration = Date.now() - startTime;
      console.log(`Request completed in ${duration}ms`);
    })
  );
  
  return response;
}
```

## Examples

### Good Examples

```typescript
// Complete middleware example
import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';
import { ipAddress } from '@vercel/functions';

export const config = {
  matcher: [
    '/api/:path*',
    '/admin/:path*'
  ]
};

export default function middleware(request: NextRequest) {
  const ip = ipAddress(request);
  const country = request.geo?.country;
  
  // Rate limiting
  if (isRateLimited(ip)) {
    return new Response('Too Many Requests', { status: 429 });
  }
  
  // Geographic restrictions
  if (country === 'XX' && request.nextUrl.pathname.startsWith('/admin')) {
    return NextResponse.redirect(new URL('/blocked', request.url));
  }
  
  // Add custom headers
  const response = NextResponse.next();
  response.headers.set('x-request-id', generateRequestId());
  response.headers.set('x-server-region', request.geo?.region || 'unknown');
  
  return response;
}
```

```typescript
// API route with proper error handling
export default async function handler(request: Request) {
  try {
    const { method } = request;
    
    if (method !== 'GET') {
      return new Response('Method not allowed', { status: 405 });
    }
    
    const data = await fetchData();
    
    return new Response(JSON.stringify(data), {
      headers: {
        'Content-Type': 'application/json',
        'Cache-Control': 'public, max-age=300'
      }
    });
  } catch (error) {
    console.error('API error:', error);
    return new Response('Internal server error', { status: 500 });
  }
}
```

### Bad Examples

```typescript
// ❌ INCORRECT - Missing config object
export default function middleware(request: Request) {
  return new Response('OK');
}
```
*Fails: Missing config object means middleware won't run on any routes.*

```typescript
// ❌ INCORRECT - Wrong file extension without module type
// middleware.js - without "type": "module" in package.json
export default function middleware(request) {
  return new Response('OK');
}
```
*Fails: JavaScript files need "type": "module" in package.json or use .mjs extension.*

```typescript
// ❌ INCORRECT - No error handling
export default function middleware(request: Request) {
  const result = riskyOperation(request); // Could throw
  return new Response(JSON.stringify(result));
}
```
*Fails: No error handling could crash the middleware.*

## Implementation Guidelines

### Deployment Checklist

Before deploying to Vercel, verify:
- [ ] Middleware file is named `middleware.ts` and placed at project root
- [ ] Config object is properly defined with appropriate matchers
- [ ] Environment variables are set in Vercel dashboard
- [ ] Error handling is implemented for all middleware functions
- [ ] Rate limiting is configured for public APIs
- [ ] Security headers are properly set
- [ ] Caching strategies are implemented where appropriate
- [ ] Logging is configured for monitoring
- [ ] Performance budgets are respected

### Vercel-Specific Considerations

#### Function Limits
- **Execution time**: 10 seconds for Hobby, 60 seconds for Pro
- **Memory**: 1024MB for Hobby, 3008MB for Pro
- **Request size**: 4.5MB for request body
- **Response size**: 4.5MB for response body

#### Edge Runtime Benefits
- Faster cold starts
- Lower latency
- Global distribution
- Better performance for simple operations

#### Monitoring Integration
```typescript
// ✅ CORRECT - Vercel Analytics integration
import { Analytics } from '@vercel/analytics';

export default function middleware(request: Request) {
  // Track custom events
  Analytics.track('middleware_execution', {
    path: request.url,
    method: request.method
  });
  
  return new Response('OK');
}
```

### Performance Optimization

#### Bundle Size Optimization
- Use dynamic imports for large dependencies
- Implement tree shaking for unused code
- Use Vercel's automatic code splitting
- Optimize images with Vercel's Image Optimization

#### Caching Strategies
- Use Vercel's Edge Network for static content
- Implement ISR (Incremental Static Regeneration) where appropriate
- Use Vercel's Data Cache for API responses
- Configure proper cache headers

