### Pagination and Infinite Loading

#### Infinite Scroll Implementation
```typescript
// ✅ CORRECT - Infinite scroll with virtual scrolling
interface PaginatedResponse<T> {
  data: T[];
  hasMore: boolean;
  nextCursor?: string;
  total?: number;
}

export function useInfiniteScroll<T>(
  fetchPage: (cursor?: string) => Promise<PaginatedResponse<T>>,
  options: {
    pageSize?: number;
    threshold?: number;
    enabled?: boolean;
  } = {}
) {
  const {
    pageSize = 20,
    threshold = 0.8,
    enabled = true,
  } = options;

  const [state, setState] = useState<{
    data: T[];
    loading: boolean;
    loadingMore: boolean;
    error: string | null;
    hasMore: boolean;
    nextCursor?: string;
  }>({
    data: [],
    loading: true,
    loadingMore: false,
    error: null,
    hasMore: true,
  });

  const loadInitial = useCallback(async () => {
    setState(prev => ({ ...prev, loading: true, error: null }));

    try {
      const response = await fetchPage();
      setState({
        data: response.data,
        loading: false,
        loadingMore: false,
        error: null,
        hasMore: response.hasMore,
        nextCursor: response.nextCursor,
      });
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Failed to load data';
      setState(prev => ({
        ...prev,
        loading: false,
        error: errorMessage,
      }));
    }
  }, [fetchPage]);

  const loadMore = useCallback(async () => {
    if (!state.hasMore || state.loadingMore || state.loading) return;

    setState(prev => ({ ...prev, loadingMore: true, error: null }));

    try {
      const response = await fetchPage(state.nextCursor);
      setState(prev => ({
        ...prev,
        data: [...prev.data, ...response.data],
        loadingMore: false,
        hasMore: response.hasMore,
        nextCursor: response.nextCursor,
      }));
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Failed to load more data';
      setState(prev => ({
        ...prev,
        loadingMore: false,
        error: errorMessage,
      }));
    }
  }, [fetchPage, state.nextCursor, state.hasMore, state.loadingMore, state.loading]);

  // Intersection Observer for automatic loading
  const observerRef = useRef<IntersectionObserver>();
  const sentinelRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!enabled || !sentinelRef.current) return;

    observerRef.current = new IntersectionObserver(
      (entries) => {
        const [entry] = entries;
        if (entry.isIntersecting && state.hasMore && !state.loadingMore) {
          loadMore();
        }
      },
      { threshold }
    );

    observerRef.current.observe(sentinelRef.current);

    return () => {
      if (observerRef.current) {
        observerRef.current.disconnect();
      }
    };
  }, [enabled, threshold, state.hasMore, state.loadingMore, loadMore]);

  useEffect(() => {
    loadInitial();
  }, [loadInitial]);

  const reset = useCallback(() => {
    setState({
      data: [],
      loading: true,
      loadingMore: false,
      error: null,
      hasMore: true,
      nextCursor: undefined,
    });
    loadInitial();
  }, [loadInitial]);

  return {
    ...state,
    loadMore,
    reset,
    sentinelRef,
  };
}
```

### Real-time Data Updates

#### WebSocket Integration
```typescript
// ✅ CORRECT - WebSocket with reconnection and state sync
export function useRealtimeData<T>(
  initialLoader: () => Promise<T>,
  websocketUrl: string,
  options: {
    reconnectAttempts?: number;
    reconnectDelay?: number;
    heartbeatInterval?: number;
  } = {}
) {
  const {
    reconnectAttempts = 5,
    reconnectDelay = 1000,
    heartbeatInterval = 30000,
  } = options;

  const [state, setState] = useState<{
    data: T | null;
    loading: boolean;
    error: string | null;
    connected: boolean;
    reconnecting: boolean;
  }>({
    data: null,
    loading: true,
    error: null,
    connected: false,
    reconnecting: false,
  });

  const wsRef = useRef<WebSocket | null>(null);
  const reconnectCountRef = useRef(0);
  const heartbeatRef = useRef<NodeJS.Timeout>();

  const connect = useCallback(() => {
    if (wsRef.current?.readyState === WebSocket.OPEN) return;

    setState(prev => ({ ...prev, reconnecting: true }));

    try {
      wsRef.current = new WebSocket(websocketUrl);

      wsRef.current.onopen = () => {
        setState(prev => ({ 
          ...prev, 
          connected: true, 
          reconnecting: false,
          error: null,
        }));
        reconnectCountRef.current = 0;

        // Start heartbeat
        heartbeatRef.current = setInterval(() => {
          if (wsRef.current?.readyState === WebSocket.OPEN) {
            wsRef.current.send(JSON.stringify({ type: 'ping' }));
          }
        }, heartbeatInterval);
      };

      wsRef.current.onmessage = (event) => {
        try {
          const message = JSON.parse(event.data);
          
          if (message.type === 'data_update') {
            setState(prev => ({ ...prev, data: message.data }));
          }
        } catch (error) {
          console.error('Failed to parse WebSocket message:', error);
        }
      };

      wsRef.current.onclose = () => {
        setState(prev => ({ ...prev, connected: false }));
        
        if (heartbeatRef.current) {
          clearInterval(heartbeatRef.current);
        }

        // Attempt reconnection
        if (reconnectCountRef.current < reconnectAttempts) {
          reconnectCountRef.current++;
          const delay = reconnectDelay * Math.pow(2, reconnectCountRef.current - 1);
          
          setTimeout(() => {
            connect();
          }, delay);
        } else {
          setState(prev => ({ 
            ...prev, 
            reconnecting: false,
            error: 'Failed to establish WebSocket connection',
          }));
        }
      };

      wsRef.current.onerror = (error) => {
        console.error('WebSocket error:', error);
        setState(prev => ({ 
          ...prev, 
          error: 'WebSocket connection error',
        }));
      };
    } catch (error) {
      setState(prev => ({ 
        ...prev, 
        reconnecting: false,
        error: 'Failed to create WebSocket connection',
      }));
    }
  }, [websocketUrl, reconnectAttempts, reconnectDelay, heartbeatInterval]);

  const disconnect = useCallback(() => {
    if (heartbeatRef.current) {
      clearInterval(heartbeatRef.current);
    }
    
    if (wsRef.current) {
      wsRef.current.close();
      wsRef.current = null;
    }
    
    setState(prev => ({ ...prev, connected: false, reconnecting: false }));
  }, []);

  // Load initial data
  useEffect(() => {
    const loadInitialData = async () => {
      try {
        const data = await initialLoader();
        setState(prev => ({ ...prev, data, loading: false }));
      } catch (error) {
        const errorMessage = error instanceof Error ? error.message : 'Failed to load initial data';
        setState(prev => ({ ...prev, loading: false, error: errorMessage }));
      }
    };

    loadInitialData();
  }, [initialLoader]);

  // Establish WebSocket connection
  useEffect(() => {
    connect();
    return disconnect;
  }, [connect, disconnect]);

  return {
    ...state,
    connect,
    disconnect,
  };
}
```

## Examples

### Good Examples

```typescript
// ✅ CORRECT - Well-structured async state hook
export function useBeers() {
  const [state, setState] = useState<{
    beers: Beer[];
    loading: boolean;
    error: string | null;
  }>({
    beers: [],
    loading: true,
    error: null,
  });

  const loadBeers = useCallback(async () => {
    try {
      setState(prev => ({ ...prev, loading: true, error: null }));
      const data = await beerLoader.loadAll();
      setState({ beers: data, loading: false, error: null });
    } catch (err) {
      setState(prev => ({
        ...prev,
        loading: false,
        error: err instanceof Error ? err.message : 'Failed to load beers',
      }));
    }
  }, []);

  useEffect(() => {
    loadBeers();
  }, [loadBeers]);

  return {
    ...state,
    reload: loadBeers,
  };
}
```

```typescript
// ✅ CORRECT - Cached data loading with stale-while-revalidate
export function useCachedBeers() {
  return useCachedData(
    'beers',
    () => beerLoader.loadAll(),
    {
      memoryTTL: 5 * 60 * 1000, // 5 minutes
      sessionTTL: 30 * 60 * 1000, // 30 minutes
      localTTL: 24 * 60 * 60 * 1000, // 24 hours
      tags: ['beers', 'menu'],
      staleWhileRevalidate: true,
    }
  );
}
```

```typescript
// ✅ CORRECT - Error handling with retry logic
export function useBeersWithRetry() {
  return useAsyncStateWithErrorHandling(
    () => beerLoader.loadAll(),
    {
      maxRetries: 3,
      baseRetryDelay: 1000,
      onError: (error) => {
        console.error('Beer loading error:', error);
      },
      fallbackData: [],
    }
  );
}
