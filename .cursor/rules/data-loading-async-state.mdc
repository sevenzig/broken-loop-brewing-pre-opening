#### Collection Loading Pattern
```typescript
// ✅ CORRECT - Collection loading with filtering and stats
interface CollectionState<T> extends AsyncState<T[]> {
  filteredData: T[];
  stats: CollectionStats;
  filters: Record<string, any>;
  sortConfig: SortConfig;
}

interface CollectionStats {
  total: number;
  filtered: number;
  categories: Record<string, number>;
  lastUpdated: string;
}

interface SortConfig {
  field: string;
  direction: 'asc' | 'desc';
}

export function useCollectionLoader<T>(
  loader: () => Promise<T[]>,
  options: {
    filters?: Record<string, (items: T[]) => T[]>;
    statsCalculator?: (items: T[]) => CollectionStats;
    defaultSort?: SortConfig;
    cacheKey?: string;
  } = {}
) {
  const {
    filters = {},
    statsCalculator,
    defaultSort = { field: 'name', direction: 'asc' },
    cacheKey,
  } = options;

  const [activeFilters, setActiveFilters] = useState<Record<string, any>>({});
  const [sortConfig, setSortConfig] = useState<SortConfig>(defaultSort);

  const asyncState = useAsyncState(loader, { cacheKey });

  // Memoized filtered data
  const filteredData = useMemo(() => {
    if (!asyncState.data) return [];

    let result = asyncState.data;

    // Apply active filters
    Object.entries(activeFilters).forEach(([filterKey, filterValue]) => {
      if (filterValue && filters[filterKey]) {
        result = filters[filterKey](result);
      }
    });

    // Apply sorting
    result = [...result].sort((a, b) => {
      const aValue = (a as any)[sortConfig.field];
      const bValue = (b as any)[sortConfig.field];

      if (typeof aValue === 'string' && typeof bValue === 'string') {
        return sortConfig.direction === 'asc'
          ? aValue.localeCompare(bValue)
          : bValue.localeCompare(aValue);
      }

      if (typeof aValue === 'number' && typeof bValue === 'number') {
        return sortConfig.direction === 'asc'
          ? aValue - bValue
          : bValue - aValue;
      }

      return 0;
    });

    return result;
  }, [asyncState.data, activeFilters, sortConfig, filters]);

  // Memoized stats
  const stats = useMemo(() => {
    if (!asyncState.data) {
      return {
        total: 0,
        filtered: 0,
        categories: {},
        lastUpdated: new Date().toISOString(),
      };
    }

    if (statsCalculator) {
      return statsCalculator(asyncState.data);
    }

    // Default stats calculation
    return {
      total: asyncState.data.length,
      filtered: filteredData.length,
      categories: asyncState.data.reduce((acc, item) => {
        const category = (item as any).category || 'uncategorized';
        acc[category] = (acc[category] || 0) + 1;
        return acc;
      }, {} as Record<string, number>),
      lastUpdated: new Date().toISOString(),
    };
  }, [asyncState.data, filteredData, statsCalculator]);

  const setFilter = useCallback((key: string, value: any) => {
    setActiveFilters(prev => ({ ...prev, [key]: value }));
  }, []);

  const clearFilters = useCallback(() => {
    setActiveFilters({});
  }, []);

  const setSortBy = useCallback((field: string, direction: 'asc' | 'desc') => {
    setSortConfig({ field, direction });
  }, []);

  return {
    // Async state
    ...asyncState,
    
    // Collection-specific data
    filteredData,
    stats,
    filters: activeFilters,
    sortConfig,
    
    // Collection actions
    setFilter,
    clearFilters,
    setSortBy,
  };
}
