### Caching Strategies

#### Multi-Level Caching System
```typescript
// ✅ CORRECT - Comprehensive caching system
interface CacheEntry<T> {
  data: T;
  timestamp: number;
  ttl: number;
  tags: string[];
}

class CacheManager {
  private memoryCache = new Map<string, CacheEntry<any>>();
  private readonly maxMemoryEntries = 100;

  // Memory cache operations
  set<T>(key: string, data: T, ttl: number = 5 * 60 * 1000, tags: string[] = []): void {
    // Implement LRU eviction if cache is full
    if (this.memoryCache.size >= this.maxMemoryEntries) {
      const oldestKey = this.memoryCache.keys().next().value;
      this.memoryCache.delete(oldestKey);
    }

    this.memoryCache.set(key, {
      data,
      timestamp: Date.now(),
      ttl,
      tags,
    });
  }

  get<T>(key: string): T | null {
    const entry = this.memoryCache.get(key);
    if (!entry) return null;

    // Check if expired
    if (Date.now() - entry.timestamp > entry.ttl) {
      this.memoryCache.delete(key);
      return null;
    }

    return entry.data;
  }

  invalidate(key: string): void {
    this.memoryCache.delete(key);
  }

  invalidateByTag(tag: string): void {
    for (const [key, entry] of this.memoryCache.entries()) {
      if (entry.tags.includes(tag)) {
        this.memoryCache.delete(key);
      }
    }
  }

  clear(): void {
    this.memoryCache.clear();
  }

  // Session storage operations
  setSession<T>(key: string, data: T): void {
    try {
      sessionStorage.setItem(key, JSON.stringify({
        data,
        timestamp: Date.now(),
      }));
    } catch (error) {
      console.warn('Failed to save to session storage:', error);
    }
  }

  getSession<T>(key: string, maxAge: number = 30 * 60 * 1000): T | null {
    try {
      const item = sessionStorage.getItem(key);
      if (!item) return null;

      const { data, timestamp } = JSON.parse(item);
      
      if (Date.now() - timestamp > maxAge) {
        sessionStorage.removeItem(key);
        return null;
      }

      return data;
    } catch (error) {
      console.warn('Failed to read from session storage:', error);
      return null;
    }
  }

  // Local storage operations (for persistent cache)
  setLocal<T>(key: string, data: T, ttl: number = 24 * 60 * 60 * 1000): void {
    try {
      localStorage.setItem(key, JSON.stringify({
        data,
        timestamp: Date.now(),
        ttl,
      }));
    } catch (error) {
      console.warn('Failed to save to local storage:', error);
    }
  }

  getLocal<T>(key: string): T | null {
    try {
      const item = localStorage.getItem(key);
      if (!item) return null;

      const { data, timestamp, ttl } = JSON.parse(item);
      
      if (Date.now() - timestamp > ttl) {
        localStorage.removeItem(key);
        return null;
      }

      return data;
    } catch (error) {
      console.warn('Failed to read from local storage:', error);
      return null;
    }
  }
}

export const cacheManager = new CacheManager();

// Hook for cached data loading
export function useCachedData<T>(
  key: string,
  fetcher: () => Promise<T>,
  options: {
    memoryTTL?: number;
    sessionTTL?: number;
    localTTL?: number;
    tags?: string[];
    staleWhileRevalidate?: boolean;
  } = {}
) {
  const {
    memoryTTL = 5 * 60 * 1000,
    sessionTTL = 30 * 60 * 1000,
    localTTL = 24 * 60 * 60 * 1000,
    tags = [],
    staleWhileRevalidate = true,
  } = options;

  const [state, setState] = useState<{
    data: T | null;
    loading: boolean;
    error: string | null;
    isStale: boolean;
  }>({
    data: null,
    loading: true,
    error: null,
    isStale: false,
  });

  const loadData = useCallback(async (useCache = true): Promise<T> => {
    // Try cache layers in order: memory -> session -> local
    if (useCache) {
      let cachedData = cacheManager.get<T>(key);
      let isStale = false;

      if (!cachedData) {
        cachedData = cacheManager.getSession<T>(key, sessionTTL);
        if (cachedData) {
          // Promote to memory cache
          cacheManager.set(key, cachedData, memoryTTL, tags);
        }
      }

      if (!cachedData) {
        cachedData = cacheManager.getLocal<T>(key);
        if (cachedData) {
          // Promote to memory and session cache
          cacheManager.set(key, cachedData, memoryTTL, tags);
          cacheManager.setSession(key, cachedData);
          isStale = true; // Local cache data is considered stale
        }
      }

      if (cachedData) {
        setState(prev => ({
          ...prev,
          data: cachedData,
          loading: staleWhileRevalidate && isStale,
          error: null,
          isStale,
        }));

        // If using stale-while-revalidate and data is stale, fetch fresh data
        if (staleWhileRevalidate && isStale) {
          try {
            const freshData = await fetcher();
            
            // Update all cache layers
            cacheManager.set(key, freshData, memoryTTL, tags);
            cacheManager.setSession(key, freshData);
            cacheManager.setLocal(key, freshData, localTTL);

            setState(prev => ({
              ...prev,
              data: freshData,
              loading: false,
              isStale: false,
            }));

            return freshData;
          } catch (error) {
            // If fresh fetch fails, keep stale data but stop loading
            setState(prev => ({ ...prev, loading: false }));
            throw error;
          }
        }

        return cachedData;
      }
    }

    // No cached data, fetch fresh
    setState(prev => ({ ...prev, loading: true, error: null }));

    try {
      const freshData = await fetcher();
      
      // Store in all cache layers
      cacheManager.set(key, freshData, memoryTTL, tags);
      cacheManager.setSession(key, freshData);
      cacheManager.setLocal(key, freshData, localTTL);

      setState({
        data: freshData,
        loading: false,
        error: null,
        isStale: false,
      });

      return freshData;
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Failed to load data';
      setState(prev => ({
        ...prev,
        loading: false,
        error: errorMessage,
      }));
      throw error;
    }
  }, [key, fetcher, memoryTTL, sessionTTL, localTTL, tags, staleWhileRevalidate]);

  const invalidate = useCallback(() => {
    cacheManager.invalidate(key);
    sessionStorage.removeItem(key);
    localStorage.removeItem(key);
  }, [key]);

  const refresh = useCallback(() => {
    return loadData(false);
  }, [loadData]);

  useEffect(() => {
    loadData();
  }, [loadData]);

  return {
    ...state,
    refresh,
    invalidate,
  };
}
