### Performance Optimization

#### Request Deduplication and Batching
```typescript
// ✅ CORRECT - Request deduplication
class RequestManager {
  private pendingRequests = new Map<string, Promise<any>>();
  private batchQueue = new Map<string, Array<{ resolve: Function; reject: Function; params: any }>>();
  private batchTimeouts = new Map<string, NodeJS.Timeout>();

  // Deduplicate identical requests
  async dedupe<T>(key: string, requestFn: () => Promise<T>): Promise<T> {
    if (this.pendingRequests.has(key)) {
      return this.pendingRequests.get(key);
    }

    const promise = requestFn().finally(() => {
      this.pendingRequests.delete(key);
    });

    this.pendingRequests.set(key, promise);
    return promise;
  }

  // Batch multiple requests
  async batch<T>(
    batchKey: string,
    params: any,
    batchFn: (paramsList: any[]) => Promise<T[]>,
    delay: number = 50
  ): Promise<T> {
    return new Promise((resolve, reject) => {
      if (!this.batchQueue.has(batchKey)) {
        this.batchQueue.set(batchKey, []);
      }

      const queue = this.batchQueue.get(batchKey)!;
      queue.push({ resolve, reject, params });

      // Clear existing timeout
      if (this.batchTimeouts.has(batchKey)) {
        clearTimeout(this.batchTimeouts.get(batchKey)!);
      }

      // Set new timeout
      const timeout = setTimeout(async () => {
        const currentQueue = this.batchQueue.get(batchKey) || [];
        this.batchQueue.delete(batchKey);
        this.batchTimeouts.delete(batchKey);

        if (currentQueue.length === 0) return;

        try {
          const paramsList = currentQueue.map(item => item.params);
          const results = await batchFn(paramsList);

          currentQueue.forEach((item, index) => {
            item.resolve(results[index]);
          });
        } catch (error) {
          currentQueue.forEach(item => {
            item.reject(error);
          });
        }
      }, delay);

      this.batchTimeouts.set(batchKey, timeout);
    });
  }
}

export const requestManager = new RequestManager();

// Hook for deduplicated requests
export function useDeduplicatedRequest<T>(
  key: string,
  requestFn: () => Promise<T>,
  dependencies: any[] = []
) {
  const [state, setState] = useState<{
    data: T | null;
    loading: boolean;
    error: string | null;
  }>({
    data: null,
    loading: true,
    error: null,
  });

  const execute = useCallback(async () => {
    setState(prev => ({ ...prev, loading: true, error: null }));

    try {
      const result = await requestManager.dedupe(key, requestFn);
      setState({
        data: result,
        loading: false,
        error: null,
      });
      return result;
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Request failed';
      setState(prev => ({
        ...prev,
        loading: false,
        error: errorMessage,
      }));
      throw error;
    }
  }, [key, requestFn]);

  useEffect(() => {
    execute();
  }, [execute, ...dependencies]);

  return {
    ...state,
    execute,
  };
}
