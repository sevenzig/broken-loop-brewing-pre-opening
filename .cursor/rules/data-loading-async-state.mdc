### Error Handling Strategies

#### Error Classification and Recovery
```typescript
// ✅ CORRECT - Comprehensive error handling
export enum ErrorType {
  NETWORK = 'NETWORK',
  VALIDATION = 'VALIDATION',
  AUTHENTICATION = 'AUTHENTICATION',
  AUTHORIZATION = 'AUTHORIZATION',
  NOT_FOUND = 'NOT_FOUND',
  SERVER = 'SERVER',
  UNKNOWN = 'UNKNOWN',
}

export interface AppError {
  type: ErrorType;
  message: string;
  code?: string;
  details?: any;
  retryable: boolean;
  timestamp: number;
}

export class ErrorHandler {
  static classify(error: any): AppError {
    const timestamp = Date.now();

    // Network errors
    if (!navigator.onLine) {
      return {
        type: ErrorType.NETWORK,
        message: 'No internet connection. Please check your network.',
        retryable: true,
        timestamp,
      };
    }

    // HTTP errors
    if (error.response) {
      const status = error.response.status;
      
      switch (status) {
        case 400:
          return {
            type: ErrorType.VALIDATION,
            message: error.response.data?.message || 'Invalid request data',
            details: error.response.data?.errors,
            retryable: false,
            timestamp,
          };
        case 401:
          return {
            type: ErrorType.AUTHENTICATION,
            message: 'Authentication required. Please log in.',
            retryable: false,
            timestamp,
          };
        case 403:
          return {
            type: ErrorType.AUTHORIZATION,
            message: 'You do not have permission to access this resource.',
            retryable: false,
            timestamp,
          };
        case 404:
          return {
            type: ErrorType.NOT_FOUND,
            message: 'The requested resource was not found.',
            retryable: false,
            timestamp,
          };
        case 429:
          return {
            type: ErrorType.NETWORK,
            message: 'Too many requests. Please try again later.',
            retryable: true,
            timestamp,
          };
        case 500:
        case 502:
        case 503:
        case 504:
          return {
            type: ErrorType.SERVER,
            message: 'Server error. Please try again later.',
            retryable: true,
            timestamp,
          };
        default:
          return {
            type: ErrorType.UNKNOWN,
            message: error.response.data?.message || 'An unexpected error occurred',
            retryable: false,
            timestamp,
          };
      }
    }

    // Request timeout
    if (error.code === 'ECONNABORTED') {
      return {
        type: ErrorType.NETWORK,
        message: 'Request timeout. Please try again.',
        retryable: true,
        timestamp,
      };
    }

    // Generic error
    return {
      type: ErrorType.UNKNOWN,
      message: error.message || 'An unexpected error occurred',
      retryable: false,
      timestamp,
    };
  }

  static shouldRetry(error: AppError, retryCount: number, maxRetries: number): boolean {
    if (retryCount >= maxRetries) return false;
    if (!error.retryable) return false;
    
    // Don't retry validation errors
    if (error.type === ErrorType.VALIDATION) return false;
    
    return true;
  }

  static getRetryDelay(retryCount: number, baseDelay: number = 1000): number {
    // Exponential backoff with jitter
    const exponentialDelay = baseDelay * Math.pow(2, retryCount);
    const jitter = Math.random() * 0.1 * exponentialDelay;
    return exponentialDelay + jitter;
  }
}

// Enhanced async state with error handling
export function useAsyncStateWithErrorHandling<T>(
  asyncFunction: () => Promise<T>,
  options: {
    maxRetries?: number;
    baseRetryDelay?: number;
    onError?: (error: AppError) => void;
    fallbackData?: T;
  } = {}
) {
  const {
    maxRetries = 3,
    baseRetryDelay = 1000,
    onError,
    fallbackData,
  } = options;

  const [state, setState] = useState<{
    data: T | null;
    loading: boolean;
    error: AppError | null;
    retryCount: number;
  }>({
    data: fallbackData || null,
    loading: false,
    error: null,
    retryCount: 0,
  });

  const execute = useCallback(async (): Promise<T> => {
    setState(prev => ({ ...prev, loading: true, error: null }));

    try {
      const result = await asyncFunction();
      setState(prev => ({
        ...prev,
        data: result,
        loading: false,
        error: null,
        retryCount: 0,
      }));
      return result;
    } catch (rawError) {
      const error = ErrorHandler.classify(rawError);
      
      setState(prev => ({
        ...prev,
        loading: false,
        error,
      }));

      onError?.(error);
      throw error;
    }
  }, [asyncFunction, onError]);

  const retry = useCallback(async (): Promise<T> => {
    const currentError = state.error;
    if (!currentError || !ErrorHandler.shouldRetry(currentError, state.retryCount, maxRetries)) {
      throw new Error('Cannot retry this operation');
    }

    setState(prev => ({ ...prev, retryCount: prev.retryCount + 1 }));

    const delay = ErrorHandler.getRetryDelay(state.retryCount, baseRetryDelay);
    await new Promise(resolve => setTimeout(resolve, delay));

    return execute();
  }, [execute, state.error, state.retryCount, maxRetries, baseRetryDelay]);

  const canRetry = useMemo(() => {
    return state.error && ErrorHandler.shouldRetry(state.error, state.retryCount, maxRetries);
  }, [state.error, state.retryCount, maxRetries]);

  return {
    ...state,
    execute,
    retry,
    canRetry,
  };
}
