# Data Loading & Async State Management

## Purpose and Scope

This rule enforces comprehensive standards for async state management, data loading patterns, and performance optimization strategies. It ensures consistent handling of asynchronous operations, proper error management, efficient caching strategies, and optimal user experience across the application. The rule establishes clear patterns for data fetching, state management, error recovery, and performance optimization.

## Standards and Requirements

### Async State Architecture

#### Standard Async State Pattern
```typescript
// ✅ CORRECT - Comprehensive async state structure
interface AsyncState<T> {
  data: T | null;
  loading: boolean;
  error: string | null;
  lastFetched: number | null;
  retryCount: number;
  hasMore?: boolean; // For pagination
}

interface AsyncActions<T> {
  execute: () => Promise<T>;
  retry: () => Promise<T>;
  reset: () => void;
  setData: (data: T) => void;
  setError: (error: string) => void;
  clearError: () => void;
}

// Base async state hook
export function useAsyncState<T>(
  asyncFunction: () => Promise<T>,
  options: {
    immediate?: boolean;
    retryAttempts?: number;
    retryDelay?: number;
    cacheKey?: string;
    cacheTTL?: number;
  } = {}
): AsyncState<T> & AsyncActions<T> {
  const {
    immediate = true,
    retryAttempts = 3,
    retryDelay = 1000,
    cacheKey,
    cacheTTL = 5 * 60 * 1000, // 5 minutes
  } = options;

  const [state, setState] = useState<AsyncState<T>>({
    data: null,
    loading: immediate,
    error: null,
    lastFetched: null,
    retryCount: 0,
  });

  const execute = useCallback(async (): Promise<T> => {
    // Check cache first
    if (cacheKey) {
      const cached = getFromCache<T>(cacheKey);
      if (cached && Date.now() - cached.timestamp < cacheTTL) {
        setState(prev => ({
          ...prev,
          data: cached.data,
          loading: false,
          error: null,
          lastFetched: cached.timestamp,
        }));
        return cached.data;
      }
    }

    setState(prev => ({ ...prev, loading: true, error: null }));

    try {
      const result = await asyncFunction();
      const timestamp = Date.now();

      // Cache the result
      if (cacheKey) {
        setInCache(cacheKey, { data: result, timestamp });
      }

      setState(prev => ({
        ...prev,
        data: result,
        loading: false,
        error: null,
        lastFetched: timestamp,
        retryCount: 0,
      }));

      return result;
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'An error occurred';
      
      setState(prev => ({
        ...prev,
        loading: false,
        error: errorMessage,
      }));

      throw error;
    }
  }, [asyncFunction, cacheKey, cacheTTL]);

  const retry = useCallback(async (): Promise<T> => {
    if (state.retryCount >= retryAttempts) {
      throw new Error('Maximum retry attempts reached');
    }

    setState(prev => ({ ...prev, retryCount: prev.retryCount + 1 }));

    // Exponential backoff
    const delay = retryDelay * Math.pow(2, state.retryCount);
    await new Promise(resolve => setTimeout(resolve, delay));

    return execute();
  }, [execute, state.retryCount, retryAttempts, retryDelay]);

  const reset = useCallback(() => {
    setState({
      data: null,
      loading: false,
      error: null,
      lastFetched: null,
      retryCount: 0,
    });
  }, []);

  const setData = useCallback((data: T) => {
    setState(prev => ({ ...prev, data, error: null }));
  }, []);

  const setError = useCallback((error: string) => {
    setState(prev => ({ ...prev, error, loading: false }));
  }, []);

  const clearError = useCallback(() => {
    setState(prev => ({ ...prev, error: null }));
  }, []);

  useEffect(() => {
    if (immediate) {
      execute().catch(() => {
        // Error is already handled in execute
      });
    }
  }, [immediate]);

  return {
    ...state,
    execute,
    retry,
    reset,
    setData,
    setError,
    clearError,
  };
}
