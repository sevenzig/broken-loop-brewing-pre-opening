## Advanced TypeScript Patterns

### 6. Utility Types Usage

```typescript
// ✅ CORRECT - Using utility types
interface User {
  id: string;
  name: string;
  email: string;
  password: string;
}

// Create types from existing interfaces
type PublicUser = Omit<User, 'password'>;
type UserUpdate = Partial<Pick<User, 'name' | 'email'>>;
type UserCreation = Omit<User, 'id'>;

// ✅ CORRECT - Record types for key-value pairs
type ErrorMessages = Record<string, string>;
type ValidationRules = Record<keyof User, (value: any) => boolean>;
```

### 7. Generic Constraints

```typescript
// ✅ CORRECT - Generic with constraints
interface Identifiable {
  id: string;
}

function updateItem<T extends Identifiable>(
  items: T[], 
  updatedItem: T
): T[] {
  return items.map(item => 
    item.id === updatedItem.id ? updatedItem : item
  );
}

// ✅ CORRECT - Conditional types
type ApiEndpoint<T> = T extends 'user' 
  ? '/api/users' 
  : T extends 'product' 
  ? '/api/products' 
  : never;
```

### 8. Form and Event Handling

```typescript
// ✅ CORRECT - Form event typing
interface LoginFormData {
  email: string;
  password: string;
}

const handleSubmit = (event: React.FormEvent<HTMLFormElement>) => {
  event.preventDefault();
  const formData = new FormData(event.currentTarget);
  // Process form data...
